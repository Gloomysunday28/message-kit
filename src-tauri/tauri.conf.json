{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LingDongDao",
  "version": "0.1.1",
  "identifier": "com.weiguang.lingdongdao",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "灵动岛",
        "width": 195,
        "height": 66,
        "minWidth": 150,
        "minHeight": 60,
        "maxWidth": 390,
        "maxHeight": 224,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "details",
        "title": "灵动岛详情",
        "url": "index.html?mode=details",
        "width": 390,
        "height": 148,
        "minWidth": 390,
        "minHeight": 148,
        "maxWidth": 390,
        "maxHeight": 148,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "visible": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "把当前聚焦的 App 放进 Mac 灵动岛",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
